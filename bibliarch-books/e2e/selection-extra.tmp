
test('continuation-page drag is not destroyed by asynchronous layout',async({page})=>{await setup(page);await page.keyboard.press('ControlOrMeta+A');await page.keyboard.insertText('Alpha bravo charlie delta echo foxtrot golf hotel. '.repeat(100));await expect.poll(()=>page.locator('.pagination-page').count()).toBeGreaterThan(1);const p=page.locator('.pagination-page').nth(1).locator('.pagination-body > p').first();await p.scrollIntoViewIfNeeded();await page.waitForTimeout(200);await drag(page,p,6,19,async()=>{await page.evaluate(()=>document.fonts.dispatchEvent(new Event('loadingdone')));await page.waitForTimeout(200);});expect((await page.evaluate(()=>getSelection().toString())).length).toBe(13);});
