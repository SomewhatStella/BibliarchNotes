{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-selection/types/**/*.ts",
    ".next-selection/dev/types/**/*.ts",
    ".next-pagination-fix/types/**/*.ts",
    ".next-pagination-fix/dev/types/**/*.ts",
    ".next-review/types/**/*.ts",
    ".next-review/dev/types/**/*.ts",
    ".next-header-clean/types/**/*.ts",
    ".next-header-clean/dev/types/**/*.ts",
    ".next-shared-account/types/**/*.ts",
    ".next-shared-account/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
